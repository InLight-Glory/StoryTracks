{
  "$ref": "#/definitions/StoryTracksProject",
  "definitions": {
    "StoryTracksProject": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "title": {
                "type": "string"
              },
              "locked": {
                "type": "boolean"
              },
              "suspended": {
                "type": "boolean"
              },
              "trashed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title",
              "locked",
              "suspended",
              "trashed"
            ],
            "additionalProperties": false
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "sectionId": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "title": {
                "type": "string"
              },
              "manualLabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metadata": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "locked": {
                "$ref": "#/definitions/StoryTracksProject/properties/sections/items/properties/locked"
              },
              "suspended": {
                "$ref": "#/definitions/StoryTracksProject/properties/sections/items/properties/suspended"
              },
              "trashed": {
                "$ref": "#/definitions/StoryTracksProject/properties/sections/items/properties/trashed"
              }
            },
            "required": [
              "id",
              "sectionId",
              "title",
              "manualLabel",
              "metadata",
              "locked",
              "suspended",
              "trashed"
            ],
            "additionalProperties": false
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "chapterId": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "beat",
                  "scene",
                  "note",
                  "turn"
                ],
                "default": "beat"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/StoryTracksProject/properties/id"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image",
                        "audio"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "default": ""
                    },
                    "assetId": {
                      "$ref": "#/definitions/StoryTracksProject/properties/id"
                    },
                    "caption": {
                      "type": "string",
                      "default": ""
                    },
                    "alt": {
                      "type": "string",
                      "default": ""
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "templateId": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "locked": {
                "$ref": "#/definitions/StoryTracksProject/properties/sections/items/properties/locked"
              },
              "suspended": {
                "$ref": "#/definitions/StoryTracksProject/properties/sections/items/properties/suspended"
              },
              "trashed": {
                "$ref": "#/definitions/StoryTracksProject/properties/sections/items/properties/trashed"
              },
              "importance": {
                "type": "integer",
                "minimum": 2,
                "maximum": 11
              },
              "liberty": {
                "type": "integer",
                "minimum": 2,
                "maximum": 11
              },
              "beginning": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "ending": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "id",
              "chapterId",
              "title",
              "blocks",
              "locked",
              "suspended",
              "trashed",
              "importance",
              "liberty",
              "beginning",
              "ending"
            ],
            "additionalProperties": false
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/StoryTracksProject/properties/nodes/items/properties/blocks/items"
                }
              },
              "importance": {
                "$ref": "#/definitions/StoryTracksProject/properties/nodes/items/properties/importance"
              },
              "liberty": {
                "$ref": "#/definitions/StoryTracksProject/properties/nodes/items/properties/liberty"
              },
              "beginning": {
                "$ref": "#/definitions/StoryTracksProject/properties/nodes/items/properties/beginning"
              },
              "ending": {
                "$ref": "#/definitions/StoryTracksProject/properties/nodes/items/properties/ending"
              }
            },
            "required": [
              "id",
              "name",
              "title",
              "blocks",
              "importance",
              "liberty",
              "beginning",
              "ending"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "ownerId": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "text": {
                "type": "string"
              },
              "include": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "ownerId",
              "text",
              "include"
            ],
            "additionalProperties": false
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "historical_transcript",
                  "reference"
                ]
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "include": {
                "type": "boolean"
              },
              "assetId": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              }
            },
            "required": [
              "id",
              "title",
              "kind",
              "text",
              "source",
              "createdAt",
              "include"
            ],
            "additionalProperties": false
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/StoryTracksProject/properties/id"
              },
              "filename": {
                "type": "string"
              },
              "mediaType": {
                "type": "string"
              },
              "data": {
                "type": "string"
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "filename",
              "mediaType",
              "data",
              "hash",
              "size"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "name",
        "description",
        "createdAt",
        "updatedAt",
        "metadata",
        "sections",
        "chapters",
        "nodes",
        "templates",
        "notes",
        "resources",
        "assets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
