  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000011",
      "chapterId": "00000000-0000-4000-8000-000000000002",
      "title": "The last train to Bellwether",
      "kind": "scene",
      "blocks": [
        {
          "id": "00000000-0000-4000-8000-000000000012",
          "type": "text",
          "text": "After twelve years away, Mara steps onto the platform with one suitcase and a letter she has not opened.\n\nThe station clock is still seven minutes slow. Some things, she thinks, have learned how to stay.",
          "caption": "",
          "alt": ""
        }
      ],
      "locked": false,
      "suspended": false,
      "trashed": false,
      "importance": 9,
      "liberty": 2,
      "beginning": 50,
      "ending": 50
    },
    {
      "id": "00000000-0000-4000-8000-000000000013",
      "chapterId": "00000000-0000-4000-8000-000000000002",
      "title": "A familiar stranger",
      "kind": "beat",
      "blocks": [
        {
          "id": "00000000-0000-4000-8000-000000000014",
          "type": "text",
          "text": "The man at the ticket window knows her name. He asks if she has come for the shop.\n\nShe has come for her father. She does not correct him.",
          "caption": "",
          "alt": ""
        }
      ],
      "locked": false,
      "suspended": false,
      "trashed": false,
      "importance": 6,
      "liberty": 5,
      "beginning": 50,
      "ending": 50
    },
    {
      "id": "00000000-0000-4000-8000-000000000015",
      "chapterId": "00000000-0000-4000-8000-000000000002",
      "title": "The map in the window",
      "kind": "turn",
      "blocks": [
        {
          "id": "00000000-0000-4000-8000-000000000016",
          "type": "text",
          "text": "Her father’s shop is exactly as she remembers, except for the map in the window: a careful rendering of Bellwether with a street that does not exist.",
          "caption": "",
          "alt": ""
        }
      ],
      "locked": false,
      "suspended": false,
      "trashed": false,
      "importance": 11,
      "liberty": 2,
      "beginning": 50,
      "ending": 80
    },
    {
      "id": "00000000-0000-4000-8000-000000000017",
      "chapterId": "00000000-0000-4000-8000-000000000002",
      "title": "A key, and a question",
      "kind": "scene",
      "blocks": [
        {
          "id": "00000000-0000-4000-8000-000000000018",
          "type": "text",
          "text": "Under the familiar loose stone, a brass key waits in an envelope. On the envelope, in her father’s handwriting: “Which way is home?”",
          "caption": "",
          "alt": ""
        }
      ],
      "locked": false,
      "suspended": false,
      "trashed": false,
      "importance": 6,
      "liberty": 2,
      "beginning": 50,
      "ending": 50
    },
    {
      "id": "00000000-0000-4000-8000-000000000019",
      "chapterId": "00000000-0000-4000-8000-000000000006",
      "title": "Everything in its place",
      "kind": "beat",
      "blocks": [
        {
          "id": "00000000-0000-4000-8000-000000000020",
          "type": "text",
          "text": "The room smells of paper, cedar, and the sea. Every drawer is labeled. One is empty.",
          "caption": "",
          "alt": ""
        }
      ],
      "locked": false,
      "suspended": false,
      "trashed": false,
      "importance": 6,
      "liberty": 2,
      "beginning": 50,
      "ending": 50
    },
    {
      "id": "00000000-0000-4000-8000-000000000021",
      "chapterId": "00000000-0000-4000-8000-000000000007",
      "title": "An impossible address",
      "kind": "beat",
      "blocks": [
        {
          "id": "00000000-0000-4000-8000-000000000022",
          "type": "text",
          "text": "Mara walks to the street on the map. The road ends at the water.",
          "caption": "",
          "alt": ""
        }
      ],
      "locked": false,
